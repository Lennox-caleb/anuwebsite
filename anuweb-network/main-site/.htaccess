# Prevent direct web access to non-public folders
RewriteEngine On
ErrorDocument 404 /404.php

# ---- School URL slugs (Phase 1 v2, 2026-09) ----
# Pretty URL: /schools/sol -> school-single.php?slug=sol (internal rewrite,
# visitor's address bar keeps showing /schools/sol). Direct
# school-single.php?slug=... links still work too; this just adds the
# short, clean public form on top.
RewriteRule ^schools/([a-z0-9-]+)/?$ school-single.php?slug=$1 [L,QSA]

# 301 redirects from the old full-word slugs to the new short-slug URLs, so
# any bookmark, search-engine index entry, or old link out there lands on
# the new address instead of a 404. One rule per school -- add a new one
# here if a school's old slug is ever retired.
RewriteCond %{QUERY_STRING} ^slug=school-of-law$
RewriteRule ^school-single\.php$ /anuweb-network/main-site/schools/sol? [R=301,L]
RewriteCond %{QUERY_STRING} ^slug=school-of-business$
RewriteRule ^school-single\.php$ /anuweb-network/main-site/schools/sob? [R=301,L]
RewriteCond %{QUERY_STRING} ^slug=school-of-science-and-technology$
RewriteRule ^school-single\.php$ /anuweb-network/main-site/schools/sst? [R=301,L]
RewriteCond %{QUERY_STRING} ^slug=school-of-humanities-and-social-sciences$
RewriteRule ^school-single\.php$ /anuweb-network/main-site/schools/shss? [R=301,L]
RewriteCond %{QUERY_STRING} ^slug=school-of-religion-and-christian-ministry$
RewriteRule ^school-single\.php$ /anuweb-network/main-site/schools/scrm? [R=301,L]

# Raise upload limits so the admin panel's file uploads (resources, staff
# photos, slider/news/programme images, up to 100MB) actually go through.
# Requires PHP running as an Apache module (mod_php) -- XAMPP's default.
# If your host runs PHP-FPM instead, these php_value lines are ignored and
# the limits must be raised in php.ini directly (see database/README further
# down, or ask your host to raise upload_max_filesize / post_max_size).
<IfModule mod_php.c>
  php_value upload_max_filesize 100M
  php_value post_max_size 110M
  php_value max_execution_time 300
  php_value max_input_time 300
</IfModule>
<IfModule mod_php7.c>
  php_value upload_max_filesize 100M
  php_value post_max_size 110M
  php_value max_execution_time 300
  php_value max_input_time 300
</IfModule>
<IfModule mod_php8.c>
  php_value upload_max_filesize 100M
  php_value post_max_size 110M
  php_value max_execution_time 300
  php_value max_input_time 300
</IfModule>

<FilesMatch "\.(sql|md)$">
  Require all denied
</FilesMatch>

Options -Indexes

# ---- Performance (Audit): compression + browser caching. Every block is wrapped in
# <IfModule>, so if a module is not enabled on the server nothing breaks.
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript text/javascript application/json image/svg+xml font/ttf
</IfModule>
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/png "access plus 6 months"
  ExpiresByType image/jpeg "access plus 6 months"
  ExpiresByType image/webp "access plus 6 months"
  ExpiresByType image/svg+xml "access plus 6 months"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
  # CSS/JS are loaded with a ?v= version stamp (asset_v), so a long cache is safe
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType text/javascript "access plus 1 month"
</IfModule>
<IfModule mod_headers.c>
  <FilesMatch "\.(php)$">
    Header set Cache-Control "no-cache, private"
  </FilesMatch>
</IfModule>

# BEGIN ANU-CLEAN-URLS (managed block - remove with: sudo bash enable-clean-urls.sh --remove)
<IfModule mod_rewrite.c>
  RewriteEngine On
  # 1) /folder/index.php  ->  /folder/   and   /page.php  ->  /page   (permanent redirects; GET/HEAD only so forms still POST normally)
  RewriteCond %{THE_REQUEST} ^(GET|HEAD)\s+/[^?\s]*\.php(\?[^\s]*)?\s+HTTP/
  RewriteCond %{REQUEST_URI} ^(.*/)index\.php$
  RewriteRule ^ %1 [R=301,L]
  RewriteCond %{THE_REQUEST} ^(GET|HEAD)\s+/[^?\s]*\.php(\?[^\s]*)?\s+HTTP/
  RewriteCond %{REQUEST_URI} ^(.*)\.php$
  RewriteRule ^ %1 [R=301,L]
  # 2) /page  ->  page.php  (internally, only when no real file/folder of that name exists)
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME}.php -f
  RewriteRule ^(.+?)/?$ $1.php [L]
</IfModule>
# END ANU-CLEAN-URLS
